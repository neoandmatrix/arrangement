# Copy to .env and fill in. Never commit .env.

# Gnani (https://app.gnani.ai/voice)
GNANI_API_KEY=

# LLM: groq (default, lowest latency) or openrouter (Gemini Flash; better Hindi, ~1-2 s slower)
LLM_PROVIDER=groq

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Thinking effort: off | minimal | low | medium | high. Lower = faster replies.
OPENROUTER_REASONING=low
# Preferred upstream provider, e.g. groq with OPENROUTER_MODEL=openai/gpt-oss-120b:
# Groq speed without Groq's free-tier limit (8,000 tokens/minute, about 2 model calls).
OPENROUTER_PROVIDER=

# Groq (https://console.groq.com), the fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high for GPT-OSS. Leave empty for non-reasoning models like llama-3.3-70b-versatile.
GROQ_REASONING_EFFORT=low

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=
# Set to 1 after upgrading from trial: enables call recording and detailed status events
TWILIO_FULL_ACCOUNT=0

# Public hostname of this server, without scheme (the cloudflared tunnel host),
# e.g. abc-def.trycloudflare.com
PUBLIC_HOST=

# Secret for POST /calls (the tunnel makes it public). Generate: openssl rand -hex 16
CONTROL_TOKEN=

# The Bandobast app: access key the app sends with every request (the tunnel makes the API public).
# Generate: openssl rand -hex 16, and enter the same key in the app's settings.
APP_KEY=

# Firebase push, so a vendor's phone rings even with the app closed. Path to the service-account
# JSON (Firebase console > Project settings > Service accounts > Generate new private key). Never commit it.
FIREBASE_SERVICE_ACCOUNT=

# Optional: web search when finding vendors near the venue (https://brave.com/search/api/, free tier)
BRAVE_SEARCH_API_KEY=

PORT=8765

# Automatic follow-ups for the current function's confirmed vendors (times are IST).
# Set to 0 for manual-only browser/demo testing. Manual Call now still uses durable claims.
AUTO_CHECKINS=1
